{
  "version": 1,
  "title": "数字孪生内容地图 · Digital Twin Content Map",
  "template": "architecture",
  "theme": "sketch",
  "sketchStyle": "review-markup",
  "cjkFontFamily": "Ma Shan Zheng",
  "cjkFontFallbacks": ["Long Cang", "Liu Jian Mao Cao", "Hannotate SC"],
  "direction": "layered",
  "nodes": [
    {
      "id": "asset",
      "label": "真实资产 / 产线 / 设备\nPhysical Asset",
      "type": "component",
      "note": "数字孪生的锚点：一台设备、一条产线、一个园区或一个产品"
    },
    {
      "id": "sensor",
      "label": "传感器与工况采集\nSensors + Telemetry",
      "type": "input",
      "note": "温度、振动、电流、位置、环境、质量检测"
    },
    {
      "id": "plc",
      "label": "控制系统 / PLC / SCADA\nControl Layer",
      "type": "service",
      "note": "动作执行、报警、联锁、工艺参数"
    },
    {
      "id": "edge",
      "label": "边缘网关\nEdge Gateway",
      "type": "service",
      "note": "协议适配、缓存、清洗、低时延推理"
    },
    {
      "id": "ingest",
      "label": "实时接入与事件流\nIoT Ingestion / Stream",
      "type": "service",
      "note": "MQTT / OPC UA / Kafka / REST"
    },
    {
      "id": "tsdb",
      "label": "时序库 + 事件库\nTime-series + Events",
      "type": "database",
      "note": "高频状态、报警、运行轨迹"
    },
    {
      "id": "lake",
      "label": "数据湖仓 / 历史样本\nLakehouse",
      "type": "database",
      "note": "批量训练、报表、追溯与质量分析"
    },
    {
      "id": "kg",
      "label": "语义模型 / 资产知识图谱\nSemantic Asset Graph",
      "type": "database",
      "note": "统一 asset ID，连接 BOM、CAD、工艺、传感点、告警"
    },
    {
      "id": "geometry",
      "label": "几何/结构模型\nCAD / BIM / OpenUSD",
      "type": "component",
      "note": "形状、位置、装配、约束"
    },
    {
      "id": "physics",
      "label": "物理仿真模型\nCAE / CFD / Thermal",
      "type": "service",
      "note": "机理、边界条件、材料参数、失效模式"
    },
    {
      "id": "ml",
      "label": "数据驱动模型\nML / Surrogate Model",
      "type": "service",
      "note": "预测、异常检测、剩余寿命、代理模型"
    },
    {
      "id": "state",
      "label": "状态估计与校准\nState Estimation",
      "type": "service",
      "note": "把实时数据映射到可解释的孪生状态"
    },
    {
      "id": "scenario",
      "label": "场景推演与优化\nWhat-if + Optimization",
      "type": "service",
      "note": "策略比较、参数寻优、风险预演"
    },
    {
      "id": "apps",
      "label": "业务应用\nOps / Maintenance / Energy",
      "type": "output",
      "note": "监控、预测维护、能效优化、质量追溯"
    },
    {
      "id": "decision",
      "label": "决策建议 / 工单 / 报告\nDecision + Work Order",
      "type": "output",
      "note": "从洞察变成可执行动作"
    },
    {
      "id": "feedback",
      "label": "闭环反馈\nControl Feedback",
      "type": "callout",
      "note": "人审或自动控制：参数下发、调度调整、维修动作"
    },
    {
      "id": "quality",
      "label": "治理底座：身份、质量、安全、血缘\nGovernance",
      "type": "note",
      "note": "没有统一 ID、权限、数据质量和版本管理，孪生会变成演示孤岛"
    },
    {
      "id": "fidelity",
      "label": "关键评审点：孪生可信度\nTwin Fidelity",
      "type": "callout",
      "note": "模型精度、刷新频率、覆盖边界、误差可解释性"
    }
  ],
